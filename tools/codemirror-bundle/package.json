{
  "name": "latex-preview-codemirror-bundle",
  "private": true,
  "description": "Builds editor/vendor/codemirror.mjs, the CodeMirror 6 bundle the Editor | PDF view loads.",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../editor/vendor/codemirror.mjs"
  },
  "dependencies": {
    "codemirror": "6.0.1",
    "@codemirror/view": "6.36.4",
    "@codemirror/state": "6.5.2",
    "@codemirror/language": "6.10.8",
    "@codemirror/legacy-modes": "6.4.2",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/commands": "6.8.0",
    "@codemirror/search": "6.5.10",
    "@codemirror/autocomplete": "6.20.4",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
